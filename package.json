{
  "name": "opencode-vscode",
  "displayName": "OpenCode for VS Code",
  "description": "A chat panel for your local opencode CLI: streaming replies, sessions tree, native diffs and permission prompts. Reuses your existing opencode login (including OpenCode Go subscriptions).",
  "version": "0.4.18",
  "publisher": "qh747",
  "license": "MIT",
  "icon": "icons/marketplace.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/qh747/opencode-vscode-plugin.git"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "keywords": [
    "opencode",
    "ai",
    "agent",
    "coding agent",
    "chat"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onView:opencode.chat",
    "onView:opencode.sessions"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "opencode-secondary",
          "title": "OpenCode",
          "icon": "icons/activity.svg"
        }
      ]
    },
    "views": {
      "opencode-secondary": [
        {
          "id": "opencode.chat",
          "type": "webview",
          "name": "OpenCode"
        }
      ]
    },
    "commands": [
      {
        "command": "opencode.newSession",
        "title": "OpenCode: New Session",
        "icon": "$(add)"
      },
      {
        "command": "opencode.history",
        "title": "OpenCode: Session History",
        "icon": "$(history)"
      },
      {
        "command": "opencode.openChat",
        "title": "OpenCode: Open Chat"
      },
      {
        "command": "opencode.openChatTab",
        "title": "OpenCode: Open Chat in Editor Tab"
      },
      {
        "command": "opencode.openCLI",
        "title": "OpenCode: Open CLI in Terminal"
      },
      {
        "command": "opencode.showLogs",
        "title": "OpenCode: Show Logs"
      },
      {
        "command": "opencode.restartServer",
        "title": "OpenCode: Restart Server"
      },
      {
        "command": "opencode.openSettings",
        "title": "OpenCode: Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "opencode.openServerConfig",
        "title": "OpenCode: Server Configuration",
        "icon": "$(settings-gear)"
      }
    ],
    "keybindings": [
      {
        "command": "opencode.openChat",
        "key": "ctrl+shift+'",
        "mac": "cmd+shift+'"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "opencode.openChatTab",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "opencode.path": {
          "type": "string",
          "default": "",
          "description": "%opencode.path.description%"
        },
        "opencode.serverUrl": {
          "type": "string",
          "default": "",
          "description": "%opencode.serverUrl.description%"
        },
        "opencode.context.autoAttachSelection": {
          "type": "boolean",
          "default": true,
          "description": "%opencode.context.autoAttachSelection.description%"
        },
        "opencode.context.maxSelectionLength": {
          "type": "number",
          "default": 2000,
          "description": "%opencode.context.maxSelectionLength.description%"
        },
        "opencode.notifications.turnComplete": {
          "type": "boolean",
          "default": true,
          "description": "%opencode.notifications.turnComplete.description%"
        },
        "opencode.notifications.permissionRequest": {
          "type": "boolean",
          "default": true,
          "description": "%opencode.notifications.permissionRequest.description%"
        },
        "opencode.notifications.errors": {
          "type": "boolean",
          "default": false,
          "description": "%opencode.notifications.errors.description%"
        },
        "opencode.composer.submitKey": {
          "type": "string",
          "enum": [
            "enter",
            "ctrlEnter"
          ],
          "enumDescriptions": [
            "%opencode.composer.submitKey.enter%",
            "%opencode.composer.submitKey.ctrlEnter%"
          ],
          "default": "enter",
          "description": "%opencode.composer.submitKey.description%"
        },
        "opencode.composer.showContextBar": {
          "type": "boolean",
          "default": true,
          "description": "%opencode.composer.showContextBar.description%"
        },
        "opencode.diffList.maxVisibleRows": {
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "description": "%opencode.diffList.maxVisibleRows.description%"
        },
        "opencode.ui.preferredLocation": {
          "type": "string",
          "enum": [
            "sidebar",
            "editor"
          ],
          "enumDescriptions": [
            "%opencode.ui.preferredLocation.sidebar%",
            "%opencode.ui.preferredLocation.editor%"
          ],
          "default": "sidebar",
          "description": "%opencode.ui.preferredLocation.description%"
        },
        "opencode.startup.autoOpen": {
          "type": "boolean",
          "default": false,
          "description": "%opencode.startup.autoOpen.description%"
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src webview-ui test",
    "test": "node esbuild.mjs --tests && node out/tests.cjs",
    "prototype:history": "node prototype/history-status/build.mjs",
    "prototype:queue": "node prototype/message-queue/build.mjs",
    "prototype:render": "node prototype/chat-render/build.mjs",
    "prototype:attach": "node prototype/attach-render/build.mjs",
    "prototype:diffs": "node prototype/diff-visibility/build.mjs",
    "prototype:send-stop": "node prototype/send-stop/build.mjs",
    "vscode:prepublish": "npm run typecheck && npm run lint && npm run compile",
    "package": "node scripts/release.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/vscode": "^1.106.0",
    "@vscode/vsce": "^3.0.0",
    "dompurify": "^3.2.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "jsdom": "^31.0.1",
    "marked": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  }
}
